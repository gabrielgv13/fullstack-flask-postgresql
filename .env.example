# Copy to .env — Flask auto-loads this from the project root.
# (set `FLASK_SKIP_DOTENV=1` to opt out)

FLASK_APP=fullstack_flask_postgresql.app
FLASK_DEBUG=1

# Required. Point at any reachable PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supermercado

# Sessions, flashes, CSRF. Set a long random value in production.
SECRET_KEY=change-me
